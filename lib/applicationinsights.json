{
  "connectionString": "${file:/mnt/secrets/ccd/app-insights-connection-string}",
  "role": {
    "name": "ccd-data-store-api"
  },
  "preview": {
    "processors": [
      {
        "type": "attribute",
        "actions": [
          {
            "key": "url.query",
            "pattern": "(?i)(?<name>case(?:\\.|%2e)[^=&]+)=[^&]*",
            "replace": "${name}=REDACTED",
            "action": "mask"
          },
          {
            "key": "http.url",
            "pattern": "(?i)(?<name>case(?:\\.|%2e)[^=&]+)=[^&]*",
            "replace": "${name}=REDACTED",
            "action": "mask"
          }
        ]
      }
    ],
    "sampling": {
      "overrides": [
        {
          "telemetryType": "request",
          "attributes": [
            {
              "key": "http.url",
              "value": "https?://[^/]+/health.*",
              "matchType": "regexp"
            }
          ],
          "percentage": 1
        }
      ]
    }
  }
}
