withNightlyPipeline(type, product, component) {

    //stage('Wait for ccd-definition-store-api job') {
    //    script {
    //        echo "Waiting for upstream ccd-definition-store-api job to complete..."
    //        build job: 'HMCTS_a_to_c_Nightly/ccd-definition-store-api/master', wait: true, propagate: false
    //    }
    //}

    overrideVaultEnvironments(vaultOverrides)
    disableLegacyDeploymentOnAAT()
    loadVaultSecrets(secrets)
    enableDbMigration('ccd')
    disableLegacyDeployment()
    enableHighLevelDataSetup()
    enableFortifyScan()

    afterAlways('fortify-scan') {
        steps.archiveArtifacts allowEmptyArchive: true, artifacts: '**/Fortify Scan/**/*'
    }

    afterAlways('fortify-scan') {

        stage('Suppress and Send Slack Notification') {

            script {
                if (env.CHANGE_ID) {
                    echo "This is a PR: #${env.CHANGE_ID}"
                    echo "Source branch: ${env.CHANGE_BRANCH}"
                    echo "Target branch: ${env.CHANGE_TARGET}"
                } else {
                    echo "Not a pull request — branch: ${env.BRANCH_NAME}"
                }
            }

            def suppressionFile = ''
            def baselineSuppressionFile = 'build/cve-suppression-baseline.xml'
            script {
                suppressionFile = sh(
                    script: './gradlew printSuppressionFile -q',
                    returnStdout: true
                ).trim().split("=")[1]

                echo "Suppression file and path: ${suppressionFile}"

                sh """
                  echo 'Current contents of ${suppressionFile}:'
                  cat '${suppressionFile}'
                """

                writeFile(
                    file: baselineSuppressionFile,
                    text: sh(script: "git show HEAD:${suppressionFile}", returnStdout: true)
                )
            }

            def slackNotificationChannel = '#nightly_cve_suppressions'

            sh './gradlew suppressCves'

            // Store the list of changed files
            def changedFiles = ''

            // Store the changes in the suppression file
            def changes = ''

            script {
                // Stage all modified tracked files
                sh 'git add -u'

                changedFiles = sh(
                    script: 'git diff --cached --name-only',
                    returnStdout: true
                ).trim().split("\n").findAll { it?.trim() } as List

                echo "List of changed files: ${changedFiles}"

                if (changedFiles.isEmpty()) {
                    echo "No changed files to extract."
                } else {
                    def fileName = sh(
                        script: """
                            echo '${changedFiles}' | tr -d '[]' | xargs basename
                        """,
                        returnStdout: true
                    ).trim()

                    echo "Extracted file name: ${fileName}"
                }

                if (changedFiles.size() == 1 && changedFiles[0] == suppressionFile) {
                    echo "✅ Only suppression file changed. Proceeding..."

                    // Verify it includes CVE-related changes
                    changes = sh(
                        script: """
                          git diff --cached ${suppressionFile} | grep '^+' | grep '<cve>' || true
                        """,
                        returnStdout: true
                    ).trim()

                    if (changes) {
                        echo "✅ CVE-related changes found in suppression file."
                    } else {
                        echo "⚠️ No CVE-related changes detected."
                    }

                } else {
                    echo "✅ Suppression file not changed — marking step as successfull"
                }
            }

            if (changes && env.CHANGE_ID) {
                echo "CVE suppression changes detected during PR validation; skipping automated PR creation."
            } else if (changes) {
                sh "./gradlew validateGeneratedCveSuppressions -PbaselineSuppressionFile=${baselineSuppressionFile}"

                // Clean and format CVE lines
                def simplifiedChanges = changes
                    .readLines()
                    .collect { it.replaceFirst(/\+/, '').trim() }                // Remove leading '+'
                    .collect { it.replaceAll(/<\/?[^>]+>/, '') }                 // Strip XML/HTML tags
                //.collect { it.replace('[Ticket]', '<https://yourtracker.example/TICKET-ID|Ticket>') } // Optional link
                    .join('\n')

                echo "Staged files: ${changedFiles}"
                echo "Changes: ${changes}"

                def targetBranch = env.BRANCH_NAME
                def automationBranch = "automated/cve-suppressions-${env.BUILD_NUMBER}"
                def credentialsId = env.GIT_CREDENTIALS_ID
                def githubProject = new GithubAPI(this).currentProject()
                def headCommit = ''

                echo "Committing changes for branch ${automationBranch}"
                sh 'git commit -m "Suppressing CVE - Actions"'
                headCommit = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()

                withCredentials([
                    gitUsernamePassword(credentialsId: credentialsId, gitToolName: 'Default')
                ]) {
                    sh """
                        git push origin HEAD:refs/heads/${automationBranch}
                    """
                }

                def pullRequestResponse = httpRequest(
                    acceptType: 'APPLICATION_JSON',
                    authentication: credentialsId,
                    consoleLogResponseBody: false,
                    contentType: 'APPLICATION_JSON',
                    httpMode: 'POST',
                    requestBody: JsonOutput.toJson([
                        title: 'Suppress newly detected CVEs',
                        head: automationBranch,
                        base: targetBranch,
                        body: "Automated CVE suppression update generated and validated by ${env.JOB_NAME} #${env.BUILD_NUMBER}."
                    ]),
                    url: "https://api.github.com/repos/${githubProject}/pulls",
                    validResponseCodes: '201'
                )
                def pullRequest = readJSON returnPojo: true, text: pullRequestResponse.content
                def pullRequestNumber = pullRequest.number
                def pullRequestUrl = pullRequest.html_url
                def requiredCheck = 'continuous-integration/jenkins/pr-head'
                pullRequestResponse = null
                pullRequest = null

                try {
                    httpRequest(
                        acceptType: 'APPLICATION_JSON',
                        authentication: credentialsId,
                        consoleLogResponseBody: false,
                        contentType: 'APPLICATION_JSON',
                        httpMode: 'POST',
                        requestBody: JsonOutput.toJson([
                            state: 'success',
                            context: requiredCheck,
                            description: 'CVE suppressions validated by the Jenkins nightly pipeline',
                            target_url: env.BUILD_URL
                        ]),
                        url: "https://api.github.com/repos/${githubProject}/statuses/${headCommit}",
                        validResponseCodes: '201'
                    )

                    def mergeResponse = httpRequest(
                        acceptType: 'APPLICATION_JSON',
                        authentication: credentialsId,
                        consoleLogResponseBody: false,
                        contentType: 'APPLICATION_JSON',
                        httpMode: 'PUT',
                        requestBody: JsonOutput.toJson([
                            sha: headCommit,
                            merge_method: 'squash'
                        ]),
                        url: "https://api.github.com/repos/${githubProject}/pulls/${pullRequestNumber}/merge",
                        validResponseCodes: '200,405,409'
                    )
                    def mergeResult = readJSON returnPojo: true, text: mergeResponse.content
                    if (mergeResponse.status != 200 || !mergeResult.merged) {
                        error("GitHub could not merge ${pullRequestUrl}: ${mergeResult.message}")
                    }
                } catch (err) {
                    slackSend(
                        channel: slackNotificationChannel,
                        color: 'danger',
                        message: "CVE suppression PR <${pullRequestUrl}|#${pullRequestNumber}> was created but could not be merged automatically. ${env.BUILD_URL}"
                    )
                    throw err
                }

                slackSend(
                    channel: slackNotificationChannel,
                    color: '#439FE0',
                    message: """
                                *CVE Suppression PR Merged*

                                *Detected CVE changes (Please create Jira backlog ticket):*

                                ${simplifiedChanges}

                                *Pull request:* <${pullRequestUrl}|#${pullRequestNumber}>
                                *Build:* <${env.BUILD_URL}|${env.JOB_NAME} #${env.BUILD_NUMBER}>
                               """.stripIndent().trim()
                )

                withCredentials([
                    gitUsernamePassword(credentialsId: credentialsId, gitToolName: 'Default')
                ]) {
                    sh(returnStatus: true, script: "git push origin --delete ${automationBranch}")
                }
            } else {
                echo "✅ Suppression file not changed — skipping Slack notification"
            }
        }
    }

    afterAlways('test') {
