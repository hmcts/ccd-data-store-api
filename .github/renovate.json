{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchManagers": ["regex"],
      "matchDepNames": ["befta-fw", "ccd-test-definitions"],
      "matchCurrentValue": "!/^[0-9]+\\.[0-9]+\\.[0-9]+$/",
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["(^|/)build\\.gradle(\\.kts)?$"],
      "matchStrings": [
        "uk\\.gov\\.hmcts:befta-fw:(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depNameTemplate": "befta-fw",
      "packageNameTemplate": "hmcts/befta-fw",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["(^|/)build\\.gradle(\\.kts)?$"],
      "matchStrings": [
        "uk\\.gov\\.hmcts:ccd-test-definitions:(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depNameTemplate": "ccd-test-definitions",
      "packageNameTemplate": "hmcts/ccd-test-definitions",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    }
  ]
}
