{
	"_guid_": "F-1029_CreateCasePreRequisiteCaseworker",
	"_extends_": "F-1029_CreateCaseBase",

	"specs": [
		"to create a case containing rich text mark-up",
		"As a prerequisite"
	],

	"prerequisites": [ {
		"S-1029_GetCreateToken": "S-1029_GetCreateToken"
	} ],

	"request": {
		"body": {
			"data": {
				"RichTextAreaField": "<p>Hello <strong>world</strong></p>"
			}
		}
	},

	"expectedResponse": {
		"body": {
			"case_data": {
				"RichTextAreaField": "<p>Hello <strong>world</strong></p>",
				"SearchCriteria": { }
			},
			"data_classification": {
				"RichTextAreaField": "PUBLIC",
				"SearchCriteria": "[[ANYTHING_PRESENT]]"
			}
		}
	}
}
