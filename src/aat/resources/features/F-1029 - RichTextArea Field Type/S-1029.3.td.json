{
	"title": "must update a RichTextArea field successfully through an event submission",
	"_guid_": "S-1029.3",
	"_extends_": "Event_Creation_Caseworker_Base",

	"specs": [
		"an active profile in CCD",
		"contains a case Id that has just been created as in F-1029_CreateCasePreRequisiteCaseworker",
		"contains an event token for the case just created above",
		"contains a new value for the RichTextArea field"
	],

	"prerequisites": [ {
		"F-1029_CreateCasePreRequisiteCaseworker": "F-1029_CreateCasePreRequisiteCaseworker"
	}, {
		"S-1029_GetUpdateToken": "S-1029_GetUpdateToken"
	} ],

	"users": {
		"invokingUser": {
			"_extends_": "BeftaMasterCaseworker"
		}
	},

	"request": {
		"pathVariables": {
			"jid": "BEFTA_MASTER",
			"ctid": "FT_MasterCaseType",
			"cid": "${[scenarioContext][childContexts][F-1029_CreateCasePreRequisiteCaseworker][testData][actualResponse][body][id]}"
		},
		"body": {
			"data": {
				"RichTextAreaField": "<p>Updated <em>rich text</em> content</p>"
			},
			"event": {
				"id": "updateCase",
				"summary": "",
				"description": ""
			},
			"event_token": "${[scenarioContext][childContexts][S-1029_GetUpdateToken][testData][actualResponse][body][token]}"
		}
	},

	"expectedResponse": {
		"_extends_": "Common_201_Response",
		"headers": {
			"_extends_": "Common_Response_Headers"
		},
		"body": {
			"id": "[[ANYTHING_PRESENT]]",
			"jurisdiction": "BEFTA_MASTER",
			"case_type_id": "FT_MasterCaseType",
			"state": "CaseUpdated",
			"version": 1,
			"created_date": "[[ANY_STRING_NOT_NULLABLE]]",
			"last_modified": "[[ANY_STRING_NOT_NULLABLE]]",
			"last_state_modified_date": "[[ANY_STRING_NOT_NULLABLE]]",
			"security_classification": "PUBLIC",
			"supplementary_data": null,
			"after_submit_callback_response": null,
			"callback_response_status_code": null,
			"callback_response_status": null,
			"callback_error_message": null,
			"delete_draft_response_status_code": null,
			"delete_draft_response_status": null,

			"case_data": {
				"RichTextAreaField": "<p>Updated <em>rich text</em> content</p>",
				"SearchCriteria": { }
			},
			"data_classification": {
				"RichTextAreaField": "PUBLIC",
				"SearchCriteria": "[[ANYTHING_PRESENT]]"
			}
		}
	}
}
