{
  "_guid_": "S-945.1_Update_Case_ClosedForPayment",
  "_extends_": "F-945_Update_Case_Base",
  "title": "Update case to state category closed for payment",
  "specs": [
    "to submit updateCase event with post state closed for payment",
    "contains Update token created as in S-945.1_GetToken_UpdateCase"
  ],

  "request": {
    "pathVariables": {
      "cid": "${[scenarioContext][parentContext][childContexts][S-944.2_Create_Case_NotClosed][testData][actualResponse][body][id]}"
    },
    "body": {
      "event_token": "${[scenarioContext][parentContext][childContexts][S-945.1_GetToken_UpdateCase][testData][actualResponse][body][token]}",
      "event": {
        "id": "updateToClosedForPaymentCase"
      }
    }
  },

  "expectedResponse": {
    "body": {
      "state": "CaseClosedForPayment"
    }
  }
}
