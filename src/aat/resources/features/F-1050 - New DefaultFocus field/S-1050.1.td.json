{
  "_guid_": "S-1050.1",
  "productName": "CCD Data Store",
  "operationName": "fetch a case for display for Case Worker",
  "_extends_": "F-1050.1_Test_Data_Base",
  "prerequisites": [
    {
      "Token_Creation": "S-1050.1_Create_Case_Data_Token_Creation"
    }
  ],
  "specs": [
    "an active profile in CCD",
    "contains valid caseType id which has defaultFocus value set for tab",
    "fetch a case for display for Case Worker",
    "contains HTTP 200"
  ],
  "method": "GET",
  "uri": "/aggregated/caseworkers/{uid}/jurisdictions/{jid}/case-types/{ctid}/cases/{cid}",
  "request": {
    "headers": {
      "_extends_": "Common_Request_Headers"
    },
    "pathVariables": {
      "uid": "[[DEFAULT_AUTO_VALUE]]",
      "jid": "BEFTA_MASTER",
      "ctid": "FT_MasterCaseType",
      "cid": "${[scenarioContext][childContexts][S-1050.1_Create_Case_Data][testData][actualResponse][body][id]}"
    }
  },
  "expectedResponse": {
    "_extends_": "Common_200_Response",
    "body": {
      "tabs": [
        {
          "defaultFocus": true
        }
      ]
    }
  }
}
