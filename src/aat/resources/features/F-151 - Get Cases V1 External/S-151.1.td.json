{
  "_guid_": "S-151.1",
  "title": "must return the newly created case when searching by case reference",
  "productName": "CCD Data Store",
  "operationName": "get case data for a given case type as a caseworker",
  "method": "GET",
  "uri": "/caseworkers/{uid}/jurisdictions/{jid}/case-types/{ctid}/cases",
  "specs": [
    "an active caseworker profile in CCD",
    "contains the reference of the newly created case",
    "contains only the newly created case and its data, along with an HTTP 200 OK"
  ],
  "users": {
