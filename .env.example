# Copy to .env or run scripts/setup-local-secrets.sh.
# Local-only values; never use these settings for AAT or production.
DATA_STORE_DB_USERNAME=data_store
DATA_STORE_DB_PASSWORD=replace-with-local-db-password
DATA_STORE_IDAM_KEY=replace-with-local-idam-key
DATA_STORE_TOKEN_SECRET=replace-with-local-token-secret
SERVER_PORT=4452
AZURE_APPLICATIONINSIGHTS_INSTRUMENTATIONKEY=local-only
